@startuml
title Strategy — Shipping Cost

class ShippingContext {
  - strategy : ShippingStrategy
  + setStrategy(s: ShippingStrategy)
  + calculate(order: Order) : Money
}

interface ShippingStrategy {
  + calculate(order: Order) : Money
}

class ExpressShippingStrategy
class NormalShippingStrategy
class EcoShippingStrategy

ShippingStrategy <|.. ExpressShippingStrategy
ShippingStrategy <|.. NormalShippingStrategy
ShippingStrategy <|.. EcoShippingStrategy

ShippingContext o-- ShippingStrategy : "utilise"
ShippingContext ..> Order
ShippingContext ..> Money

class Order {
  + weightKg : double
  + distanceKm : int
  + deadlineDays : int
  + countryCode : String
}

class Money {
  + amount : double
  + currency : String
}

@enduml
